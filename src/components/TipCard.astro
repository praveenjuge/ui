---
import Figure from "./Figure.astro";
import { CATEGORIES } from "../lib/categories";
import { tipPath, type Tip } from "../lib/tips";

interface Props {
  tip: Tip;
  /** The title's heading level: h2 in a page's grid, h3 under a section's own heading. */
  heading?: "h2" | "h3";
}

const { tip, heading: Heading = "h2" } = Astro.props;
const { title, body, category, figure } = tip.data;
const search = [title, body, CATEGORIES[category].name].join(" ").toLowerCase();
---

<a href={tipPath(tip)} class="card" data-category={category} data-search={search}>
  <div class="plate">
    <Figure figure={figure} lazy />
  </div>
  <Heading class="title">{title}</Heading>
  <p class="body">{body}</p>
</a>

<style>
  .card {
    display: grid;
    gap: 6px;
    align-content: start;
  }
  .card[hidden] {
    display: none;
  }
  .plate {
    margin-bottom: 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover .plate {
      border-color: var(--line-strong);
    }
  }
  .title {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }
  /* Two lines of the tip, cut with an ellipsis; the page has the rest. */
  .body {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: 14px;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
