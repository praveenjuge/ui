---
/**
 * A tip's figure on a stage, playing its lesson on a loop. The stage ships
 * with the figure's still, drawn at build time, so the drawing shows before
 * any script runs. The figure's file is imported only when this element
 * mounts it: at once, or, with `lazy`, when it nears the viewport (and it is
 * torn down again when it leaves, so a long grid stays light).
 */
import { STILL_VIEWBOX, getFigure, stillMarkup } from "../lib/figure/still";

interface Props {
  figure: string;
  lazy?: boolean;
  class?: string;
}

const { figure, lazy = false, class: className } = Astro.props;
const loaded = getFigure(figure);
---

<tip-figure
  class:list={["figure", className]}
  data-figure={figure}
  data-lazy={lazy ? "" : undefined}
>
  <div class="stage" role="img" aria-label={loaded.means}>
    <svg class="figure-svg" viewBox={STILL_VIEWBOX} aria-hidden="true" data-still set:html={stillMarkup(loaded)} />
  </div>
</tip-figure>

<script>
  import { loadFigure, mountFigure, type Mounted } from "../lib/figure/host";

  class TipFigure extends HTMLElement {
    #mounted: Mounted | undefined;
    #io: IntersectionObserver | undefined;
    #generation = 0;

    /** The live figure, once mounted; the tip page's scrubber drives it. */
    get mounted() {
      return this.#mounted;
    }

    connectedCallback() {
      if (!this.hasAttribute("data-lazy")) return void this.#mount();
      this.#io = new IntersectionObserver(
        ([entry]) => (entry?.isIntersecting ? this.#mount() : this.#unmount()),
        { rootMargin: "400px 0px" },
      );
      this.#io.observe(this);
    }

    disconnectedCallback() {
      this.#io?.disconnect();
      this.#unmount();
    }

    async #mount() {
      if (this.#mounted) return;
      const generation = ++this.#generation;
      const figure = await loadFigure(this.dataset.figure ?? "");
      if (generation !== this.#generation || this.#mounted) return;
      const stage = this.querySelector<HTMLElement>(".stage")!;
      this.#mounted = mountFigure(stage, figure, {
        onShow: (t) => this.dispatchEvent(new CustomEvent("figure-show", { detail: t })),
      });
      this.dataset.mounted = "";
      this.dispatchEvent(new CustomEvent("figure-mount"));
    }

    #unmount() {
      this.#generation++;
      this.#mounted?.destroy();
      this.#mounted = undefined;
      delete this.dataset.mounted;
    }
  }

  customElements.define("tip-figure", TipFigure);
</script>

<style>
  .figure {
    position: relative;
    display: block;
  }
  .stage {
    aspect-ratio: 5 / 4;
    user-select: none;
    -webkit-user-select: none;
  }
</style>
