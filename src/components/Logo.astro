---
/** The cube, inline, for the header and anywhere else the page shows the mark. */
import { LOGO_FACES, LOGO_VIEW } from "../lib/logo";

interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---

<svg class={className} width={size} height={size} viewBox={`0 0 ${LOGO_VIEW} ${LOGO_VIEW}`} aria-hidden="true">
  {LOGO_FACES.map((face) => <path d={face.d} fill={face.fill} stroke={face.fill} stroke-width="0.6" stroke-linejoin="round" />)}
</svg>
