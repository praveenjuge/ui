---
import Base from "../layouts/Base.astro";
import Figure from "../components/Figure.astro";
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { CATEGORIES } from "../lib/categories";
import { IMAGE_SIZES, SHARE, SIZES, THEMES, VIDEO_SIZES, downloadName, mediaPath, pad, videoFile } from "../lib/media";
import { SITE } from "../lib/site";
import { getTips, type Tip } from "../lib/tips";

export async function getStaticPaths() {
  const tips = await getTips();
  return tips.map((tip, i) => ({
    params: { number: String(tip.data.number) },
    props: { tip, prev: tips[i - 1], next: tips[i + 1] },
  }));
}

interface Props {
  tip: Tip;
  prev?: Tip;
  next?: Tip;
}

const { tip, prev, next } = Astro.props;
const { number, title, body, figure, category } = tip.data;
// Videos and the share image are rendered locally (bun run render) and committed under public/.
const rendered = (file: string) => existsSync(resolve("public", mediaPath(number, file).slice(1)));
const image = rendered(SHARE.file) ? `${SITE.url}${mediaPath(number, SHARE.file)}` : undefined;
const videos = VIDEO_SIZES.map((size) => ({
  size,
  links: THEMES.filter((theme) => rendered(videoFile(size, theme))).map((theme) => ({
    theme,
    href: mediaPath(number, videoFile(size, theme)),
    name: downloadName(number, size, theme, "mp4"),
  })),
})).filter((row) => row.links.length);
const themeLabel = { light: "Light", dark: "Dark" } as const;
---

<Base title={title} description={body} image={image}>
  <article class="wrap">
    <div class="tip">
      <div class="plate">
        <Figure figure={figure} />
      </div>

      <div class="head">
        <p class="meta"><span class="number">{pad(number)}</span>{CATEGORIES[category]}</p>
        <div class="actions" data-figure={figure} data-words={JSON.stringify({ number, title, body })}>
          <button type="button" class="download" popovertarget="downloads">
            Download
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 6.5 3.5 3.5 3.5-3.5"></path></svg>
          </button>
          <div id="downloads" class="menu" popover>
            <p class="group">Image <span>PNG</span></p>
            {
              IMAGE_SIZES.map((size) => (
                <div class="row">
                  <span class="ratio">{SIZES[size].label}</span>
                  {THEMES.map((theme) => (
                    <button type="button" class="item" data-size={size} data-theme-choice={theme}>
                      {themeLabel[theme]}
                    </button>
                  ))}
                </div>
              ))
            }
            {
              videos.length > 0 && (
                <>
                  <p class="group">
                    Video <span>MP4 · 8s</span>
                  </p>
                  {videos.map((row) => (
                    <div class="row">
                      <span class="ratio">{SIZES[row.size].label}</span>
                      {row.links.map((link) => (
                        <a class="item" href={link.href} download={link.name}>
                          {themeLabel[link.theme]}
                        </a>
                      ))}
                    </div>
                  ))}
                </>
              )
            }
            <p class="note">Free for personal use.</p>
          </div>
        </div>
      </div>

      <div class="text">
        <h1>{title}</h1>
        <p class="body">{body}</p>
      </div>

      <nav class="pager" aria-label="More tips">
        {
          prev ? (
            <a href={`/${prev.data.number}`} rel="prev" data-key="ArrowLeft">
              <span>← Previous</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={`/${next.data.number}`} rel="next" data-key="ArrowRight" class="next">
              <span>Next →</span>
              {next.data.title}
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<script>
  import { composeRest, type Words } from "../lib/compose";
  import { loadFigure } from "../lib/figure/host";
  import { downloadName, type Size, type Theme } from "../lib/media";

  const actions = document.querySelector<HTMLElement>(".actions")!;
  const menu = document.getElementById("downloads")!;
  const words = JSON.parse(actions.dataset.words!) as Words;

  menu.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("a.item")) return void menu.hidePopover();
    const button = target.closest<HTMLButtonElement>("button[data-size]");
    if (!button || button.disabled) return;
    const size = button.dataset.size as Size;
    const theme = button.dataset.themeChoice as Theme;
    button.disabled = true;
    try {
      const canvas = await composeRest(await loadFigure(actions.dataset.figure!), words, size, theme);
      const blob = await new Promise<Blob | null>((done) => canvas.toBlob(done, "image/png"));
      if (!blob) throw new Error("Could not make the image");
      const url = URL.createObjectURL(blob);
      const link = Object.assign(document.createElement("a"), { href: url, download: downloadName(words.number, size, theme, "png") });
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 10_000);
      menu.hidePopover();
    } finally {
      button.disabled = false;
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    const target = event.target as HTMLElement;
    if (target.closest("input, textarea, select, [contenteditable], [popover]:popover-open")) return;
    const link = document.querySelector<HTMLAnchorElement>(`.pager a[data-key="${event.key}"]`);
    if (link) location.href = link.href;
  });
</script>

<style>
  .tip {
    display: grid;
    gap: 20px;
    max-width: 720px;
    padding-top: 16px;
  }
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 4px;
  }
  .plate {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .text {
    display: grid;
    gap: 12px;
  }
  .meta {
    display: flex;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .number {
    font-family: var(--mono);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  h1 {
    font-size: clamp(26px, 4.5vw, 34px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .body {
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }

  /* The download button and its menu. */
  .download {
    anchor-name: --download;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 10px 0 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .download:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .download:hover {
      border-color: var(--line-strong);
    }
  }
  .download svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .menu {
    width: 252px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: var(--shadow);
    /* Opens from the button: a quick fade and a slight scale, never from nothing. */
    transform-origin: top right;
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 180ms var(--ease-out),
      transform 180ms var(--ease-out),
      overlay 180ms allow-discrete,
      display 180ms allow-discrete;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  .menu:not(:popover-open) {
    opacity: 0;
    transform: scale(0.97);
    transition-duration: 120ms;
  }
  @supports (position-area: bottom) {
    .menu {
      position-anchor: --download;
      position-area: bottom span-left;
      position-try-fallbacks: flip-block, flip-inline;
      inset: auto;
      margin: 8px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu:not(:popover-open) {
      transform: none;
    }
  }
  .group {
    display: flex;
    justify-content: space-between;
    padding: 8px 8px 4px;
    font-size: 12px;
    font-weight: 600;
  }
  .group span {
    font-weight: 400;
    color: var(--muted);
  }
  .group:not(:first-child) {
    margin-top: 4px;
    border-top: 1px solid var(--line);
    padding-top: 10px;
  }
  .row {
    display: grid;
    grid-template-columns: 52px 1fr 1fr;
    align-items: center;
    gap: 2px;
  }
  .ratio {
    padding-left: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .item {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 30px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    font-size: 13px;
    cursor: pointer;
    transition:
      background-color 120ms ease,
      transform 160ms var(--ease-out);
  }
  .item:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .item:hover {
      background: var(--surface);
    }
  }
  .item:disabled {
    cursor: progress;
    color: var(--muted);
  }
  .note {
    padding: 8px 8px 4px;
    font-size: 12px;
    color: var(--muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .pager a {
    display: grid;
    gap: 4px;
    transition: color 150ms ease;
  }
  .pager a span {
    font-size: 12px;
    color: var(--muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .pager a:hover {
      color: var(--accent);
    }
  }
  .pager .next {
    text-align: right;
  }
</style>
