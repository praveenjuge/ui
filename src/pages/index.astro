---
import Base from "../layouts/Base.astro";
import TipGrid from "../components/TipGrid.astro";
import { collection } from "../lib/schema";
import { SITE } from "../lib/site";
import { getTips } from "../lib/tips";

const tips = (await getTips()).reverse();
---

<Base schema={[collection("/", SITE.brand, SITE.description, tips)]}>
  <section class="wrap intro">
    <h1>Small UI tips, one a day.</h1>
    <p><strong>{SITE.tagline}</strong> Short notes on layout, type, forms and accessibility, each drawn as the mistake turning into the fix.</p>
  </section>

  <TipGrid tips={tips} />
</Base>

<style>
  .intro {
    display: grid;
    gap: 10px;
    padding-top: 48px;
    padding-bottom: 40px;
  }
  .intro h1 {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .intro p {
    max-width: 50ch;
    font-size: 16px;
    color: var(--muted);
    text-wrap: pretty;
  }
  .intro strong {
    font-weight: 500;
    color: var(--ink);
  }
</style>
