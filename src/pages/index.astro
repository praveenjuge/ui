---
import Base from "../layouts/Base.astro";
import TipCard from "../components/TipCard.astro";
import { CATEGORIES, CATEGORY_IDS } from "../lib/categories";
import { getTips } from "../lib/tips";

const tips = (await getTips()).reverse();
---

<Base>
  <section class="wrap intro">
    <h1>Small UI tips, one a day.</h1>
    <p>Short notes on layout, type, forms and accessibility, each shown as the mistake and the fix.</p>
  </section>

  <section class="wrap controls" aria-label="Filter tips">
    <div class="chips" role="group" aria-label="Category">
      <button type="button" class="chip" data-category="" aria-pressed="true">All</button>
      {
        CATEGORY_IDS.map((id) => (
          <button type="button" class="chip" data-category={id} aria-pressed="false">
            {CATEGORIES[id]}
          </button>
        ))
      }
    </div>
    <label class="search">
      <span class="visually-hidden">Search tips</span>
      <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="m10.5 10.5 3 3"></path></svg>
      <input id="search" type="search" placeholder="Search" autocomplete="off" spellcheck="false" />
    </label>
  </section>

  <section class="wrap grid" id="grid">
    {tips.map((tip) => <TipCard tip={tip} />)}
  </section>
  <p class="wrap empty" id="empty" hidden>No tips match that.</p>
</Base>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>("#grid .card")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip")];
  const input = document.getElementById("search") as HTMLInputElement;
  const empty = document.getElementById("empty")!;
  const params = new URLSearchParams(location.search);
  let category = params.get("category") ?? "";
  input.value = params.get("q") ?? "";

  function apply() {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const match =
        (!category || card.dataset.category === category) &&
        words.every((word) => card.dataset.search!.includes(word));
      card.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
    for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.category === category));

    const url = new URL(location.href);
    category ? url.searchParams.set("category", category) : url.searchParams.delete("category");
    input.value ? url.searchParams.set("q", input.value) : url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      category = chip.dataset.category ?? "";
      apply();
    });
  }
  input.addEventListener("input", apply);
  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && document.activeElement !== input) {
      event.preventDefault();
      input.focus();
    }
  });
  apply();
</script>

<style>
  .intro {
    display: grid;
    gap: 10px;
    padding-top: 48px;
    padding-bottom: 40px;
  }
  .intro h1 {
    font-size: clamp(28px, 5vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .intro p {
    max-width: 46ch;
    font-size: 16px;
    color: var(--muted);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 28px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }
  .chip {
    height: 30px;
    padding: 0 12px;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font-size: 13px;
    cursor: pointer;
    transition:
      color 150ms ease,
      background-color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .chip:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .chip:hover {
      color: var(--ink);
    }
  }
  .chip[aria-pressed="true"] {
    background: var(--surface);
    color: var(--ink);
  }
  .search {
    position: relative;
    flex: 0 1 220px;
  }
  .search svg {
    position: absolute;
    left: 10px;
    top: 50%;
    width: 14px;
    height: 14px;
    translate: 0 -50%;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.4;
    stroke-linecap: round;
    pointer-events: none;
  }
  .search input {
    width: 100%;
    height: 32px;
    padding: 0 12px 0 30px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--bg);
    font-size: 13px;
    transition: border-color 150ms ease;
  }
  .search input::placeholder {
    color: var(--muted);
  }
  .search input:focus {
    outline: none;
    border-color: var(--line-strong);
  }
  @media (max-width: 560px) {
    .search {
      flex-basis: 100%;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 40px 24px;
  }
  .empty {
    padding-top: 24px;
    color: var(--muted);
  }
</style>
