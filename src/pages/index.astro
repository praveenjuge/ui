---
import Base from "../layouts/Base.astro";
import TipCard from "../components/TipCard.astro";
import { CATEGORIES, CATEGORY_IDS } from "../lib/categories";
import { getTips } from "../lib/tips";

const tips = (await getTips()).reverse();
---

<Base>
  <section class="wrap intro">
    <h1>Small UI tips, one a day.</h1>
    <p class="muted">
      Short, numbered notes on layout, type, forms and accessibility. Each one has a line drawing you can poke at, and
      images and videos you can download.
    </p>
  </section>

  <section class="wrap controls" aria-label="Filter tips">
    <div class="chips" role="group" aria-label="Category">
      <button type="button" class="chip mono" data-category="" aria-pressed="true">All</button>
      {
        CATEGORY_IDS.map((id) => (
          <button type="button" class="chip mono" data-category={id} aria-pressed="false">
            {CATEGORIES[id]}
          </button>
        ))
      }
    </div>
    <label class="search">
      <span class="visually-hidden">Search tips</span>
      <input id="search" type="search" placeholder="Search" autocomplete="off" spellcheck="false" />
    </label>
  </section>

  <section class="wrap grid" id="grid">
    {tips.map((tip) => <TipCard tip={tip} />)}
  </section>
  <p class="wrap empty muted" id="empty" hidden>No tips match that. Try another word or category.</p>
</Base>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>("#grid .card")];
  const chips = [...document.querySelectorAll<HTMLButtonElement>(".chip")];
  const input = document.getElementById("search") as HTMLInputElement;
  const empty = document.getElementById("empty")!;
  const params = new URLSearchParams(location.search);
  let category = params.get("category") ?? "";
  input.value = params.get("q") ?? "";

  function apply() {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    for (const card of cards) {
      const match =
        (!category || card.dataset.category === category) &&
        words.every((word) => card.dataset.search!.includes(word));
      card.hidden = !match;
      if (match) shown++;
    }
    empty.hidden = shown > 0;
    for (const chip of chips) chip.setAttribute("aria-pressed", String(chip.dataset.category === category));

    const url = new URL(location.href);
    category ? url.searchParams.set("category", category) : url.searchParams.delete("category");
    input.value ? url.searchParams.set("q", input.value) : url.searchParams.delete("q");
    history.replaceState(null, "", url);
  }

  for (const chip of chips) {
    chip.addEventListener("click", () => {
      category = chip.dataset.category ?? "";
      apply();
    });
  }
  input.addEventListener("input", apply);
  document.addEventListener("keydown", (event) => {
    if (event.key === "/" && document.activeElement !== input) {
      event.preventDefault();
      input.focus();
    }
  });
  apply();
</script>

<style>
  .intro {
    display: grid;
    gap: 12px;
    padding-top: 56px;
    padding-bottom: 40px;
  }
  .intro h1 {
    font-size: clamp(30px, 6vw, 48px);
    line-height: 1.08;
    font-weight: 560;
    letter-spacing: -0.035em;
  }
  .intro p {
    max-width: 52ch;
    font-size: 16px;
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 20px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .chip {
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .chip:hover {
    color: var(--ink);
    border-color: var(--muted);
  }
  .chip[aria-pressed="true"] {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--accent);
  }
  .search {
    flex: 1 1 200px;
    max-width: 280px;
  }
  .search input {
    width: 100%;
    height: 36px;
    padding: 0 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    font-size: 14px;
  }
  .search input:focus {
    outline: none;
    border-color: var(--accent);
  }
  @media (max-width: 560px) {
    .search {
      max-width: none;
    }
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 16px;
  }
  .empty {
    padding-top: 32px;
  }
</style>
