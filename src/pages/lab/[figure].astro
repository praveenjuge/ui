---
/**
 * A figure's proof sheet, for drawing one: /lab/<name>. It shows the
 * mistake, halfway and the fix in both themes, the rest pose at thumbnail
 * size, and the live loop. `bun run look <name>` photographs it and
 * checks it. Not for readers, and not in the sitemap.
 */
import "../../styles/global.css";
import Fonts from "../../components/Fonts.astro";

export function getStaticPaths() {
  return Object.keys(import.meta.glob("../../figures/*.ts")).map((path) => ({
    params: { figure: path.split("/").pop()!.replace(/\.ts$/, "") },
  }));
}

const { figure } = Astro.params;
const STATES = [
  { at: 0, label: "t 0 · mistake" },
  { at: 0.5, label: "t 0.5" },
  { at: 1, label: "t 1 · fix, rest" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Lab · {figure}</title>
    <Fonts />
  </head>
  <body data-figure={figure}>
    <h1 class="mono">{figure}</h1>
    {
      (["light", "dark"] as const).map((theme) => (
        <section class="row" data-theme={theme}>
          {STATES.map((state) => (
            <figure>
              <div class="stage" data-at={state.at} />
              <figcaption class="mono">{`${theme} · ${state.label}`}</figcaption>
            </figure>
          ))}
        </section>
      ))
    }
    <section class="row" data-theme="light">
      <figure class="small">
        <div class="stage" data-at="1"></div>
        <figcaption class="mono">240px · rest</figcaption>
      </figure>
      <figure>
        <div class="stage" data-live></div>
        <figcaption class="mono">live: the 8s loop</figcaption>
      </figure>
    </section>
    <p class="mono" id="report"></p>

    <script>
      import { SAFE } from "../../lib/figure";
      import { loadFigure, mountFigure } from "../../lib/figure/host";

      const figure = await loadFigure(document.body.dataset.figure!);
      const problems: string[] = [];
      for (const stage of document.querySelectorAll<HTMLElement>(".stage")) {
        const live = stage.hasAttribute("data-live");
        const at = Number(stage.dataset.at ?? 1);
        const { svg } = mountFigure(stage, figure, live ? {} : { play: false, at });
        if (live) continue;
        const box = svg.getBBox();
        const inside =
          box.x >= SAFE.x - 0.5 &&
          box.y >= SAFE.y - 0.5 &&
          box.x + box.width <= SAFE.x + SAFE.width + 0.5 &&
          box.y + box.height <= SAFE.y + SAFE.height + 0.5;
        if (!inside) {
          const r = (n: number) => Math.round(n);
          problems.push(`t ${at}: drawing spans x ${r(box.x)}–${r(box.x + box.width)}, y ${r(box.y)}–${r(box.y + box.height)}, outside the safe area x 24–376, y 32–288`);
        }
      }
      if (!figure.means || figure.means.length > 160) problems.push("means must be one sentence, 160 characters at most");
      await document.fonts.ready;
      const report = document.getElementById("report")!;
      report.textContent = problems.length ? problems.join("\n") : "ok";
      document.body.dataset.problems = String(problems.length);
      document.body.dataset.ready = "";
    </script>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: 24px;
    background: #f0f0f3;
    color: #141418;
    font: 13px var(--sans);
  }
  h1 {
    margin: 0 0 16px;
    font-size: 13px;
  }
  .row {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    align-items: flex-start;
  }
  figure {
    margin: 0;
    width: 400px;
    padding: 0;
    background: var(--bg);
    border-radius: 12px;
    overflow: hidden;
  }
  figure.small {
    width: 240px;
  }
  .stage {
    aspect-ratio: 5 / 4;
  }
  figcaption {
    padding: 8px 12px;
    border-top: 1px solid var(--line);
    color: var(--muted);
  }
  #report {
    white-space: pre-wrap;
  }
</style>
