---
import Base from "../layouts/Base.astro";
---

<Base title="Not found">
  <section class="wrap missing">
    <p class="mono accent">404</p>
    <h1>There's no tip here.</h1>
    <p class="muted">It may not be published yet. <a href="/">See all tips</a>.</p>
  </section>
</Base>

<style>
  .missing {
    display: grid;
    gap: 12px;
    padding-top: 96px;
  }
  h1 {
    font-size: 32px;
    font-weight: 560;
    letter-spacing: -0.03em;
  }
  a {
    color: var(--accent);
  }
</style>
