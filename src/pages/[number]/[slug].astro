---
import { existsSync } from "node:fs";
import { resolve } from "node:path";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Figure from "../../components/Figure.astro";
import TipCard from "../../components/TipCard.astro";
import { CATEGORIES, categoryPath } from "../../lib/categories";
import { getFigure } from "../../lib/figure/still";
import { IMAGE_SIZES, SHARE, SIZES, THEMES, VIDEO_SIZES, downloadName, mediaPath, videoFile } from "../../lib/media";
import { breadcrumbs, categoryCrumbs, tipArticle } from "../../lib/schema";
import { SITE } from "../../lib/site";
import { getTips, relatedTips, tipLabel, tipPath, type Tip } from "../../lib/tips";

export async function getStaticPaths() {
  const tips = await getTips();
  return tips.map((tip, i) => ({
    params: { number: String(tip.data.number), slug: tip.data.slug },
    props: { tip, prev: tips[i - 1], next: tips[i + 1], related: relatedTips(tip, tips) },
  }));
}

interface Props {
  tip: Tip;
  prev?: Tip;
  next?: Tip;
  related: Tip[];
}

const { tip, prev, next, related } = Astro.props;
const { number, title, body, figure, category, date } = tip.data;
const { Content } = await render(tip);
const { means } = getFigure(figure);
const label = tipLabel(tip);
const url = new URL(tipPath(tip), SITE.url).href;
// Videos and the share image are rendered locally (bun run render) and committed under public/.
const rendered = (file: string) => existsSync(resolve("public", mediaPath(number, file).slice(1)));
const image = rendered(SHARE.file)
  ? { url: `${SITE.url}${mediaPath(number, SHARE.file)}`, alt: `${label}: ${title}. The mistake beside the fix: ${means}` }
  : undefined;
const videos = VIDEO_SIZES.map((size) => ({
  size,
  links: THEMES.filter((theme) => rendered(videoFile(size, theme))).map((theme) => ({
    theme,
    href: mediaPath(number, videoFile(size, theme)),
    name: downloadName(number, size, theme, "mp4"),
  })),
})).filter((row) => row.links.length);
const themeLabel = { light: "Light", dark: "Dark" } as const;
---

<Base
  title={title}
  series={label}
  description={body}
  image={image}
  article={{ published: date, section: CATEGORIES[category].name }}
  markdown={`${tipPath(tip)}.md`}
  schema={[
    tipArticle(tip, image?.url, means),
    breadcrumbs([["UI Tips", "/"], categoryCrumbs(category), [title, tipPath(tip)]]),
  ]}
>
  <article class="wrap">
    <div class="tip">
      <div class="plate">
        <Figure figure={figure} class="hero" />
        <div class="scrub" hidden>
          <button type="button" class="play" aria-label="Pause" data-playing="">
            <svg class="icon-pause" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 4v8M10.5 4v8"></path></svg>
            <svg class="icon-play" viewBox="0 0 16 16" aria-hidden="true"><path d="M5.5 3.8v8.4L12 8Z"></path></svg>
          </button>
          <span class="end" aria-hidden="true">Mistake</span>
          <input type="range" min="0" max="100" value="100" aria-label="From the mistake to the fix" aria-valuetext="The fix" />
          <span class="end fix" aria-hidden="true">Fix</span>
        </div>
      </div>

      <div class="head">
        <p class="meta">
          <span class="number">{label}</span>
          <span aria-hidden="true">·</span>
          <a href={categoryPath(category)}>{CATEGORIES[category].name}</a>
        </p>
        <div class="actions" data-figure={figure} data-words={JSON.stringify({ number, title, body })}>
          <button type="button" class="action" data-share data-url={url}>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 10V2.5M5 5.5l3-3 3 3M4 8.5v4h8v-4"></path></svg>
            <span>Share</span>
          </button>
          <button type="button" class="action download" popovertarget="downloads">
            Download
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4.5 6.5 3.5 3.5 3.5-3.5"></path></svg>
          </button>
          <div id="downloads" class="menu" popover aria-label="Downloads">
            <p class="group">Image <span>PNG</span></p>
            {
              IMAGE_SIZES.map((size) => (
                <div class="row">
                  <span class="ratio" aria-hidden="true">{SIZES[size].label}</span>
                  {THEMES.map((theme) => (
                    <button
                      type="button"
                      class="item"
                      data-size={size}
                      data-theme-choice={theme}
                      aria-label={`${SIZES[size].label} image, ${themeLabel[theme]}`}
                    >
                      {themeLabel[theme]}
                    </button>
                  ))}
                </div>
              ))
            }
            {
              videos.length > 0 && (
                <>
                  <p class="group">
                    Video <span>MP4 · 8s</span>
                  </p>
                  {videos.map((row) => (
                    <div class="row">
                      <span class="ratio" aria-hidden="true">{SIZES[row.size].label}</span>
                      {row.links.map((link) => (
                        <a class="item" href={link.href} download={link.name} aria-label={`${SIZES[row.size].label} video, ${themeLabel[link.theme]}`}>
                          {themeLabel[link.theme]}
                        </a>
                      ))}
                    </div>
                  ))}
                </>
              )
            }
            <p class="note">Free to share, with a link back.</p>
          </div>
          <p class="visually-hidden" id="action-status" role="status"></p>
        </div>
      </div>

      <div class="text">
        <h1>{title}</h1>
        <p class="body">{body}</p>
      </div>

      <div class="prose">
        <Content />
      </div>

      {
        related.length > 0 && (
          <section class="related" aria-labelledby="related-title">
            <h2 id="related-title">More tips</h2>
            <div class="related-grid">
              {related.map((other) => (
                <TipCard tip={other} heading="h3" />
              ))}
            </div>
          </section>
        )
      }

      <nav class="pager" aria-label="Previous and next tips">
        {
          prev ? (
            <a href={tipPath(prev)} rel="prev" data-key="ArrowLeft">
              <span><span aria-hidden="true">← </span>Previous</span>
              {prev.data.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={tipPath(next)} rel="next" data-key="ArrowRight" class="next">
              <span>Next<span aria-hidden="true"> →</span></span>
              {next.data.title}
            </a>
          )
        }
      </nav>
    </div>
  </article>
</Base>

<script>
  import { composeRest, type Words } from "../../lib/compose";
  import { loadFigure, prefersReducedMotion, type Mounted } from "../../lib/figure/host";
  import { SIZES, downloadName, type Size, type Theme } from "../../lib/media";

  const actions = document.querySelector<HTMLElement>(".actions")!;
  const menu = document.getElementById("downloads")!;
  const status = document.getElementById("action-status")!;
  const words = JSON.parse(actions.dataset.words!) as Words;

  /** Says something to screen readers, through the status region. */
  const say = (text: string) => {
    status.textContent = "";
    requestAnimationFrame(() => (status.textContent = text));
  };

  // Downloads. A busy item is marked aria-disabled, not disabled, so it keeps focus while the image is drawn.
  menu.addEventListener("click", async (event) => {
    const target = event.target as HTMLElement;
    if (target.closest("a.item")) return void menu.hidePopover();
    const button = target.closest<HTMLButtonElement>("button[data-size]");
    if (!button || button.getAttribute("aria-disabled") === "true") return;
    const size = button.dataset.size as Size;
    const theme = button.dataset.themeChoice as Theme;
    const name = `${SIZES[size].label} ${theme} image`;
    button.setAttribute("aria-disabled", "true");
    say(`Preparing the ${name}…`);
    try {
      const canvas = await composeRest(await loadFigure(actions.dataset.figure!), words, size, theme);
      const blob = await new Promise<Blob | null>((done) => canvas.toBlob(done, "image/png"));
      if (!blob) throw new Error("Could not make the image");
      const url = URL.createObjectURL(blob);
      const link = Object.assign(document.createElement("a"), { href: url, download: downloadName(words.number, size, theme, "png") });
      link.click();
      setTimeout(() => URL.revokeObjectURL(url), 10_000);
      say(`Downloaded the ${name}.`);
      menu.hidePopover();
    } catch {
      say(`Couldn't make the ${name}. Try again.`);
    } finally {
      button.removeAttribute("aria-disabled");
    }
  });

  // Share: the system's share sheet where there is one, and a copied link where there isn't.
  const share = actions.querySelector<HTMLButtonElement>("[data-share]")!;
  const shareLabel = share.querySelector("span")!;
  let reset = 0;
  share.addEventListener("click", async () => {
    const url = share.dataset.url!;
    if (navigator.share) {
      try {
        await navigator.share({ title: words.title, text: words.body, url });
      } catch {}
      return;
    }
    try {
      await navigator.clipboard.writeText(url);
      shareLabel.textContent = "Copied";
      say("Link copied.");
      clearTimeout(reset);
      reset = window.setTimeout(() => (shareLabel.textContent = "Share"), 2000);
    } catch {
      say("Couldn't copy the link.");
    }
  });

  // The scrubber: pause the loop, play it again, or drag between the mistake and the fix.
  const hero = document.querySelector<HTMLElement & { mounted?: Mounted }>("tip-figure.hero")!;
  const scrub = document.querySelector<HTMLElement>(".scrub")!;
  const play = scrub.querySelector<HTMLButtonElement>(".play")!;
  const range = scrub.querySelector<HTMLInputElement>("input")!;
  const valueText = (t: number) => (t >= 0.995 ? "The fix" : t <= 0.005 ? "The mistake" : `${Math.round(t * 100)}% of the way to the fix`);
  const showPlaying = (playing: boolean) => {
    play.toggleAttribute("data-playing", playing);
    play.setAttribute("aria-label", playing ? "Pause" : "Play");
  };
  const showT = (t: number) => {
    range.value = String(Math.round(t * 100));
    range.style.setProperty("--p", `${t * 100}%`);
    const text = valueText(t);
    if (range.getAttribute("aria-valuetext") !== text && (document.activeElement === range || t === 0 || t === 1)) {
      range.setAttribute("aria-valuetext", text);
    }
  };
  const ready = (mounted: Mounted) => {
    scrub.hidden = false;
    // Under reduced motion the figure holds the fix until someone presses play.
    if (prefersReducedMotion()) mounted.pause();
    showPlaying(mounted.playing);
    showT(mounted.t);
  };
  hero.addEventListener("figure-show", (event) => showT((event as CustomEvent<number>).detail));
  hero.addEventListener("figure-mount", () => ready(hero.mounted!));
  customElements.whenDefined("tip-figure").then(() => hero.mounted && ready(hero.mounted));
  play.addEventListener("click", () => {
    const mounted = hero.mounted;
    if (!mounted) return;
    if (mounted.playing) mounted.pause();
    else mounted.resume({ chosen: true });
    showPlaying(mounted.playing);
  });
  range.addEventListener("input", () => {
    const t = Number(range.value) / 100;
    hero.mounted?.seek(t);
    range.setAttribute("aria-valuetext", valueText(t));
    showPlaying(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.defaultPrevented || event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
    const target = event.target as HTMLElement;
    if (target.closest("input, textarea, select, [contenteditable], [popover]:popover-open")) return;
    const link = document.querySelector<HTMLAnchorElement>(`.pager a[data-key="${event.key}"]`);
    if (link) location.href = link.href;
  });
</script>

<style>
  .tip {
    display: grid;
    gap: 20px;
    max-width: 720px;
    padding-top: 16px;
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 16px;
    margin-top: 4px;
  }
  .plate {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .text {
    display: grid;
    gap: 12px;
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: var(--muted);
  }
  .meta a {
    display: inline-flex;
    align-items: center;
    min-height: var(--target);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition:
      color 150ms ease,
      text-decoration-color 150ms ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .meta a:hover {
      color: var(--ink);
      text-decoration-color: currentColor;
    }
  }
  .number {
    font-family: var(--mono);
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  h1 {
    font-size: clamp(26px, 4.5vw, 34px);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .body {
    max-width: 60ch;
    font-size: 17px;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: pretty;
  }
  .prose {
    margin-top: 4px;
    padding-top: 4px;
  }

  /* The scrubber, along the bottom of the plate. */
  .scrub {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 14px 4px 6px;
    border-top: 1px solid var(--line);
    font-size: 12px;
    color: var(--muted);
  }
  .scrub[hidden] {
    display: none;
  }
  .play {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--target);
    height: var(--target);
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition:
      background-color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .play:active {
    transform: scale(0.94);
  }
  @media (hover: hover) and (pointer: fine) {
    .play:hover {
      background: var(--surface);
    }
  }
  .play svg {
    grid-area: 1 / 1;
    width: 14px;
    height: 14px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .play .icon-play {
    fill: currentColor;
  }
  .play[data-playing] .icon-play,
  .play:not([data-playing]) .icon-pause {
    display: none;
  }
  .end {
    flex: none;
    font-family: var(--mono);
  }
  .end.fix {
    color: var(--accent);
  }
  .scrub input {
    --p: 100%;
    flex: 1;
    min-width: 0;
    height: var(--target);
    margin: 0;
    background: transparent;
    cursor: pointer;
    appearance: none;
    -webkit-appearance: none;
  }
  .scrub input::-webkit-slider-runnable-track {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--accent) var(--p), var(--line-strong) var(--p));
  }
  .scrub input::-moz-range-track {
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(to right, var(--accent) var(--p), var(--line-strong) var(--p));
  }
  .scrub input::-webkit-slider-thumb {
    width: 12px;
    height: 12px;
    margin-top: -5px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    appearance: none;
    -webkit-appearance: none;
  }
  .scrub input::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Share, and the download button and its menu. */
  .actions {
    display: flex;
    gap: 8px;
  }
  .action {
    anchor-name: --download;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--target);
    padding: 0 10px 0 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--bg);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition:
      border-color 150ms ease,
      transform 160ms var(--ease-out);
  }
  .action[data-share] {
    anchor-name: none;
    padding: 0 12px 0 10px;
  }
  .action:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .action:hover {
      border-color: var(--line-strong);
    }
  }
  .action svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: var(--muted);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .menu {
    width: 252px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--bg);
    color: var(--ink);
    box-shadow: var(--shadow);
    /* Opens from the button: a quick fade and a slight scale, never from nothing. */
    transform-origin: top right;
    opacity: 1;
    transform: scale(1);
    transition:
      opacity 180ms var(--ease-out),
      transform 180ms var(--ease-out),
      overlay 180ms allow-discrete,
      display 180ms allow-discrete;
  }
  @starting-style {
    .menu:popover-open {
      opacity: 0;
      transform: scale(0.97);
    }
  }
  .menu:not(:popover-open) {
    opacity: 0;
    transform: scale(0.97);
    transition-duration: 120ms;
  }
  @supports (position-area: bottom) {
    .menu {
      position-anchor: --download;
      position-area: bottom span-left;
      position-try-fallbacks: flip-block, flip-inline;
      inset: auto;
      margin: 8px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu,
    .menu:not(:popover-open) {
      transform: none;
    }
  }
  .group {
    display: flex;
    justify-content: space-between;
    padding: 8px 8px 4px;
    font-size: 12px;
    font-weight: 600;
  }
  .group span {
    font-weight: 400;
    color: var(--muted);
  }
  .group:not(:first-child) {
    margin-top: 4px;
    border-top: 1px solid var(--line);
    padding-top: 10px;
  }
  .row {
    display: grid;
    grid-template-columns: 52px 1fr 1fr;
    align-items: center;
    gap: 2px;
  }
  .ratio {
    padding-left: 8px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  .item {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--target);
    border: 0;
    border-radius: 8px;
    background: transparent;
    font-size: 13px;
    cursor: pointer;
    transition:
      background-color 120ms ease,
      transform 160ms var(--ease-out);
  }
  .item:active {
    transform: scale(0.97);
  }
  @media (hover: hover) and (pointer: fine) {
    .item:hover {
      background: var(--surface);
    }
  }
  .item[aria-disabled="true"] {
    cursor: progress;
    color: var(--muted);
  }
  .note {
    padding: 8px 8px 4px;
    font-size: 12px;
    color: var(--muted);
  }

  .related {
    display: grid;
    gap: 20px;
    margin-top: 28px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .related h2 {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(200px, 100%), 1fr));
    gap: 32px 20px;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 12px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 14px;
  }
  .pager a {
    display: grid;
    gap: 4px;
    transition: color 150ms ease;
  }
  .pager a > span {
    font-size: 12px;
    color: var(--muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .pager a:hover {
      color: var(--accent);
    }
  }
  .pager .next {
    text-align: right;
  }
</style>
